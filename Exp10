#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

sem_t resource;
sem_t rmutex;
sem_t wmutex;
sem_t readTry;

int read_count = 0;
int write_count = 0;
int data = 0;

void *reader(void *arg)
{
    int id = *(int *)arg;

    while (1)
    {
        sem_wait(&readTry);
        sem_wait(&rmutex);

        read_count++;
        if (read_count == 1)
            sem_wait(&resource);

        sem_post(&rmutex);
        sem_post(&readTry);

        printf("Reader %d is reading data = %d\n", id, data);
        sleep(1);

        sem_wait(&rmutex);

        read_count--;
        if (read_count == 0)
            sem_post(&resource);

        sem_post(&rmutex);

        sleep(1);
    }
}

void *writer(void *arg)
{
    int id = *(int *)arg;

    while (1)
    {
        sem_wait(&wmutex);

        write_count++;
        if (write_count == 1)
            sem_wait(&readTry);

        sem_post(&wmutex);

        sem_wait(&resource);

        data++;
        printf("Writer %d is writing data = %d\n", id, data);
        sleep(1);

        sem_post(&resource);

        sem_wait(&wmutex);

        write_count--;
        if (write_count == 0)
            sem_post(&readTry);

        sem_post(&wmutex);

        sleep(1);
    }
}

int main()
{
    pthread_t r[5], w[2];
    int r_id[5], w_id[2];

    sem_init(&resource, 0, 1);
    sem_init(&rmutex, 0, 1);
    sem_init(&wmutex, 0, 1);
    sem_init(&readTry, 0, 1);

    for (int i = 0; i < 5; i++)
    {
        r_id[i] = i + 1;
        pthread_create(&r[i], NULL, reader, &r_id[i]);
    }

    for (int i = 0; i < 2; i++)
    {
        w_id[i] = i + 1;
        pthread_create(&w[i], NULL, writer, &w_id[i]);
    }

    for (int i = 0; i < 5; i++)
        pthread_join(r[i], NULL);

    for (int i = 0; i < 2; i++)
        pthread_join(w[i], NULL);

    return 0;
}
