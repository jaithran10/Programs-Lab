#include <stdio.h>
#include <stdlib.h>
#include <semaphore.h>
#include <unistd.h>
#include <pthread.h>

sem_t mutex;
sem_t wrt;
sem_t readTry;
sem_t wmutex;

int readcount=0;
int writecount=0;

void *reader(void *arg){
    int id=*((int*)arg);

    sem_wait(&readTry);
    sem_wait(&mutex);

    readcount++;
    if(readcount==1)
        sem_wait(&wrt);

    sem_post(&mutex);
    sem_post(&readTry);

    printf("Reader %d is READING\n",id);
    sleep(1);

    sem_wait(&mutex);

    readcount--;
    if(readcount==0)
        sem_post(&wrt);

    sem_post(&mutex);
    return NULL;
}

void *writer(void *arg){
    int id=*((int*)arg);

    sem_wait(&wmutex);
    writecount++;
    if(writecount==1)
        sem_wait(&readTry);
    sem_post(&wmutex);

    sem_wait(&wrt);

    printf("Writer %d is WRITING\n",id);
    sleep(1);

    sem_post(&wrt);

    sem_wait(&wmutex);
    writecount--;
    if(writecount==0)
        sem_post(&readTry);
    sem_post(&wmutex);

    return NULL;
}

int main(){
    int rCount,wCount;

    printf("Enter number of readers: ");
    scanf("%d",&rCount);
    printf("Enter number of writers: ");
    scanf("%d",&wCount);

    pthread_t r[rCount], w[wCount];
    int rId[rCount], wId[wCount];

    sem_init(&mutex,0,1);
    sem_init(&wrt,0,1);
    sem_init(&readTry,0,1);
    sem_init(&wmutex,0,1);

    for(int i=0;i<rCount;i++){
        rId[i]=i+1;
        pthread_create(&r[i],NULL,reader,&rId[i]);
    }

    for(int i=0;i<wCount;i++){
        wId[i]=i+1;
        pthread_create(&w[i],NULL,writer,&wId[i]);
    }

    for(int i=0;i<rCount;i++)
        pthread_join(r[i],NULL);

    for(int i=0;i<wCount;i++)
        pthread_join(w[i],NULL);

    return 0;
}
